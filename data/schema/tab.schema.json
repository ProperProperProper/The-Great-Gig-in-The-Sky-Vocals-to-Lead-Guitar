{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/mirror-view-tab.schema.json",
  "title": "Mirror-view guitar tab document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "source", "tuning", "displayOrder", "measures"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "arranger": { "type": ["string", "null"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "permissionBasis"],
      "properties": {
        "kind": { "enum": ["owner-supplied", "licensed", "public-domain", "original-fixture"] },
        "reference": { "type": "string", "minLength": 1 },
        "permissionBasis": { "type": "string", "minLength": 1 },
        "license": { "type": ["string", "null"] }
      }
    },
    "tuning": {
      "const": [
        { "string": 6, "label": "E", "pitch": "E2" },
        { "string": 5, "label": "A", "pitch": "A2" },
        { "string": 4, "label": "D", "pitch": "D3" },
        { "string": 3, "label": "G", "pitch": "G3" },
        { "string": 2, "label": "B", "pitch": "B3" },
        { "string": 1, "label": "e", "pitch": "E4" }
      ]
    },
    "displayOrder": { "const": [6, 5, 4, 3, 2, 1] },
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/measure" }
    }
  },
  "$defs": {
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "width", "sourceLines", "events"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "sourceLines": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["string", "label", "content"],
            "properties": {
              "string": { "type": "integer", "minimum": 1, "maximum": 6 },
              "label": { "enum": ["E", "A", "D", "G", "B", "e"] },
              "content": { "type": "string" }
            }
          }
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "string", "column", "length"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["note", "rest"] },
        "string": { "type": "integer", "minimum": 1, "maximum": 6 },
        "column": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 },
        "fret": { "type": "integer", "minimum": 0, "maximum": 24 },
        "simultaneousGroup": { "type": ["string", "null"] },
        "techniques": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "symbol", "startColumn", "endColumn"],
            "properties": {
              "type": { "enum": ["bend", "release", "slide-up", "slide-down", "hammer-on", "pull-off", "vibrato"] },
              "symbol": { "type": "string", "minLength": 1 },
              "startColumn": { "type": "integer", "minimum": 0 },
              "endColumn": { "type": "integer", "minimum": 0 },
              "targetFret": { "type": ["integer", "null"], "minimum": 0, "maximum": 24 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "note" } } },
          "then": { "required": ["fret", "techniques"] }
        }
      ]
    }
  }
}
